    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/platform-express": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "iterare": "^1.2.1",
    "mongoose": "^8.2.0",
    "nodemon": "^3.1.14",
    "openai": "^7.5.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
